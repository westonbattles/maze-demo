---
import unityBuild from '../../unity-build.json';

const demoUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/play/index.html?v=${unityBuild.sha256.slice(0, 12)}`;
---

<section class="demo" aria-label="Maze generation demo">
  <iframe
    src={demoUrl}
    title="Interactive maze generation demo"
    allow="fullscreen; autoplay; gamepad"
    allowfullscreen
    loading="eager"
  ></iframe>
</section>

<style>
  .demo {
    margin: 0 0 0.4rem;
  }

  iframe {
    display: block;
    width: 100%;
    aspect-ratio: 8 / 5;
    border: 1px solid #52677c;
    background: #101923;
  }

  p {
    margin: 0.65rem 0 0;
    color: #b6c4d0;
    font-size: 0.8rem;
    text-align: center;
  }
</style>
